# Local Next.js secret. For production, set it with `wrangler secret put`.
LEADS_WEBHOOK_URL=
# Optional. E.164 digits only, without +. Enables WhatsApp inquiry links.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Set this to the production Worker/custom-domain URL in Cloudflare build variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
